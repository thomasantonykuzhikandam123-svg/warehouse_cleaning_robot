<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="warehouse_robot">

  <xacro:property name="body_length"  value="0.6"/>
  <xacro:property name="body_width"   value="0.4"/>
  <xacro:property name="body_height"  value="0.2"/>
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_length" value="0.05"/>
  <xacro:property name="wheel_x"      value="0.15"/>
  <xacro:property name="wheel_y"      value="0.225"/>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="blue">
    <color rgba="0.1 0.1 0.8 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

    <link name="base_link"/>
    <joint name="chassis_joint" type="fixed">
      <parent link="base_link"/>
      <child link="chassis"/>
      <origin xyz="0 0 0.2"/>
    </joint>
  
    <link name="chassis">
      <visual>
        <origin xyz="0 0 0"/> 
        <geometry>
          <box size="${body_length} ${body_width} ${body_height}"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="${body_length} ${body_width} ${body_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="5.0"/>
        <inertia
           ixx="${1/12 * 5.0*(body_width*body_width+body_height*body_height)}"
           ixy="0" ixz="0"
           iyy="${1/12 * 5.0*(body_length*body_length+body_height*body_height)}"
           iyz="0"
           izz="${1/12 * 5.0*(body_length*body_length+body_width*body_width)}"/>
      </inertial>     
    </link>

  <xacro:macro name="wheel" params="name x y">
    <joint name="base_${name}_joint" type="continuous">
      <parent link="chassis"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} -${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.5"/>
          <inertia
             ixx="${(1/12) * 0.5 * (3*wheel_radius*wheel_radius+wheel_length*wheel_length)}"
             ixy="0" ixz="0"
             izz="${(1/2) * 0.5* (wheel_radius*wheel_radius)}"
             iyz="0"
             iyy="${(1/12) * 0.5 * (3*wheel_radius*wheel_radius+wheel_length*wheel_length)}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel name="left_front_wheel"  x="${wheel_x}"  y="${wheel_y}"/>
  <xacro:wheel name="left_back_wheel"   x="-${wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="right_front_wheel" x="${wheel_x}"  y="-${wheel_y}"/>
  <xacro:wheel name="right_back_wheel"  x="-${wheel_x}" y="-${wheel_y}"/>
  
  <gazebo>
    <plugin
       filename="ignition-gazebo-diff-drive-system"
       name="ignition::gazebo::systems::DiffDrive">

       <left_joint>base_left_front_wheel_joint</left_joint>
       <left_joint>base_left_back_wheel_joint</left_joint>

       <right_joint>base_right_front_wheel_joint</right_joint>
       <right_joint>base_right_back_wheel_joint</right_joint>

       <wheel_separation>0.45</wheel_separation>
       <wheel_radius>${wheel_radius}</wheel_radius>

       <topic>/cmd_vel</topic>
       <odom_topic>/odom</odom_topic>
       <frame_id>odom</frame_id>
       <child_frame_id>base_link</child_frame_id>

       <publish_odom>true</publish_odom>
       <publish_odom_tf>true</publish_odom_tf>

    </plugin>
  </gazebo>
</robot>




